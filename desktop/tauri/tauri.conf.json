{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Downloader",
  "version": "0.1.0",
  "identifier": "local.wsy.video-downloader",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev -- --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "VITE_API_BASE_URL=http://127.0.0.1:8000 npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Video Downloader",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/sidecar": "sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  }
}
